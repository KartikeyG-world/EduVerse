# Frontend Environment Variables Template
# Deploy target: Vercel (https://vercel.com)

# Base URL for Backend API requests
VITE_API_BASE_URL=http://localhost:5000/api

# Google OAuth Client ID
# Get from: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized origins must include: http://localhost:5173, https://your-vercel-domain.vercel.app
# Authorized redirect URIs must include: https://your-vercel-domain.vercel.app
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# Facebook App ID
# Get from: https://developers.facebook.com → Your App → App Settings → Basic
# Valid OAuth Redirect URIs must include: https://your-vercel-domain.vercel.app/
VITE_FACEBOOK_APP_ID=your_facebook_app_id_here
