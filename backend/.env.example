# Backend Environment Variables Template
# Deploy target: Railway (https://railway.app)

# Server Port (Railway auto-assigns PORT — do NOT set manually on Railway)
PORT=5000

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/EduVerse?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# AI Services (OpenRouter / OpenAI)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# YouTube Data API
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Brevo (Sendinblue) HTTP API Credentials
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@domain.com

# Google OAuth (used by google-auth-library to verify ID tokens server-side)
# Must match the VITE_GOOGLE_CLIENT_ID in the frontend
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# Facebook verification is done via the Graph API using the user's access token.
# No app secret is required on the backend for this flow.

# Frontend Application URL (for CORS & Reset Password Links)
# Set this to your Vercel deployment URL in production
FRONTEND_URL=http://localhost:5173
