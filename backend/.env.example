# Backend Environment Variables Template

# Server Port
PORT=5000

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/EduVerse?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# AI Services (OpenRouter / OpenAI)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# YouTube Data API
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Nodemailer / SMTP Credentials
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password_here

# Frontend Application URL (for CORS & Reset Password Links)
FRONTEND_URL=http://localhost:5173
