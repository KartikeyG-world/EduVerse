# ==========================================
# EduVerse - Environment Variables Template
# ==========================================
# Backend: Railway  |  Frontend: Vercel

# --- Backend Configuration (set in Railway Variables tab) ---
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/EduVerse?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# --- AI & External Services (set in Railway Variables tab) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# --- Email Notifications / Brevo API (set in Railway Variables tab) ---
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@domain.com

# --- CORS & Client URLs (set in Railway Variables tab) ---
# Must match your Vercel deployment URL exactly
FRONTEND_URL=https://edu-verse-frontend-vert.vercel.app

# --- Frontend Configuration (set in Vercel Environment Variables) ---
# Must match your Railway deployment URL
VITE_API_BASE_URL=https://your-railway-backend.up.railway.app